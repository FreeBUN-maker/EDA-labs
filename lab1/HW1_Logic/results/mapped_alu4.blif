.gate ao21 a=b[2] b=a[2] c=n44 O=nb45
.gate ao22 a=nb31 b=n30 c=b[1] d=a[1] O=nb46
.gate inv1 a=nb45 O=n45
.gate oai21 a=nb46 b=n45 c=s0 O=nb49
.gate ao21 a=nb46 b=n45 c=nb49 O=nb50
.gate and3 a=b[2] b=a[2] c=nb11 O=n42
.gate nor2 a=n42 b=s1 O=n43
