.gate xor2 a=nb59 b=nb58 O=nb62
.gate nand2 a=nb62 b=s0 O=nb63
.gate and3 a=b[3] b=a[3] c=s0 O=n67
.gate inv1 a=n67 O=nb67
.gate inv1 a=n57 O=nb57
.gate and3 a=nb67 b=s1 c=nb57 O=n69
.gate ao21 a=n65 b=nb63 c=n69 O=y[3]
.gate inv1 a=nb58 O=n58
.gate ao22 a=nb59 b=n58 c=b[3] d=a[3] O=cout
.end
